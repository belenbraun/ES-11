# Supabase — proyecto compartido entre las 22
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para funciones serverless (nunca exponer en el cliente/commitear)
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) — se generan en el paso de push notifications,
# ej. con `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
